{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "贴吧采集助手",
  "version": "0.2.0",
  "identifier": "com.os.tieba-crawler",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5175 --strictPort",
    "devUrl": "http://127.0.0.1:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "贴吧采集助手",
        "width": 1440,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**", "$APPCACHE/**", "G:/OS/TiebaCrawler/data/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../python-sidecar/dist/tieba-sidecar.exe": "tieba-sidecar.exe",
      "../LICENSE": "LICENSE",
      "../NOTICE.md": "NOTICE.md"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"]
      }
    }
  }
}
